{
    "name": "nnp-shared-styles",
    "version": "1.1.6",
    "description": "Shared SCSS styling library providing design tokens, themes, layout utilities, and reusable component styles.",
    "main": "src/index.scss",
    "style": "dist/index.css",
    "sass": "src/index.scss",
    "files": [
        "src/",
        "dist/"
    ],
    "scripts": {
        "build": "sass src/index.scss dist/index.css --no-source-map",
        "build:min": "sass src/index.scss dist/index.min.css --style=compressed --no-source-map",
        "build:all": "npm run build && npm run build:min",
        "watch": "sass --watch src/index.scss dist/index.css",
        "prepare": "npm run build:all"
    },
    "keywords": [
        "scss",
        "css",
        "design-system",
        "theme",
        "shared-styles",
        "tokens",
        "ui"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nubo-Native-Platform/PICC-PC-NNP-Shared-Styles.git"
    },
    "bugs": {
        "url": "https://github.com/Nubo-Native-Platform/PICC-PC-NNP-Shared-Styles/issues"
    },
    "homepage": "https://github.com/Nubo-Native-Platform/PICC-PC-NNP-Shared-Styles#readme",
    "author": "Nubo Native Platform",
    "license": "MIT",
    "devDependencies": {
        "sass": "^1.89.2"
    }
}